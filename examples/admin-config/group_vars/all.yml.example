# Public example only — keep real secrets in group_vars/secrets.sops.yaml
ci_mode: false

system_updates:
  enabled: true
  on_calendar: "Sat *-*-* 04:00:00"
  randomized_delay_sec: "30m"
  operation_lock_timeout_sec: 1800
  service_timeout_sec: 7200
  auto_reboot: true

storage_isolation:
  enabled: true
  backend: btrfs
  migrate_existing: false
  entries:
    - name: keycloak
      path: "{{ admin_node_root }}/data/keycloak"
      size: "2G"
    - name: openbao
      path: "{{ admin_node_root }}/data/openbao"
      size: "1G"
    - name: gitea-stack
      path: "{{ admin_node_root }}/data/gitea-stack"
      size: "6G"
    - name: harbor
      path: "{{ admin_node_root }}/data/harbor"
      size: "8G"
    - name: traefik
      path: "{{ admin_node_root }}/data/traefik"
      size: "512M"
    - name: cloudflared
      path: "{{ admin_node_root }}/data/cloudflared"
      size: "512M"
    - name: backups
      path: "{{ admin_node_root }}/backups"
      size: "5G"

service_domains:
  harbor: "harbor.example.com"
  openbao: "bao.example.com"
  keycloak: "keycloak.example.com"
  gitea: "git.example.com"
  traefik: "traefik.example.com"

cloudflare:
  enabled: true
  dns:
    enabled: false
    zone: "example.com"

backup:
  offline:
    enabled: false
    on_calendar: "Sun *-*-* 04:00:00"
    randomized_delay_sec: "30m"
    retention: 2
    max_age: "192h"
    minimum_free_bytes: 32212254720
    recovery_kit_max_age: "2160h"
    recovery_kit:
      last_verified_at: "2026-01-01T00:00:00Z"
      age_identity_offsite: false
      config_repo_access_tested: false
      restic_access_offsite: false
      openbao_recovery_offsite: false
      separation_of_duties_verified: false

traefik:
  external_services: []

hardening:
  apparmor:
    enabled: true
    enforce: true
    auto_reboot: true
    profiles:
      traefik: true
      cloudflared: true
      openbao: true

oidc_clients:
  harbor:
    client_id: "harbor"
    client_secret: "{{ vault_oidc_harbor_client_secret }}"
  openbao:
    client_id: "openbao"
    client_secret: "{{ vault_oidc_openbao_client_secret }}"
  gitea:
    client_id: "gitea"
    client_secret: "{{ vault_oidc_gitea_client_secret }}"

keycloak_config:
  enabled: true
  realm:
    name: "homelab"
    display_name: "Homelab"
  realm_roles:
    - "admin"
  clients:
    - client_id: "harbor"
      redirect_uris:
        - "https://harbor.example.com/c/oidc/callback"
      web_origins:
        - "https://harbor.example.com"
    - client_id: "openbao"
      redirect_uris:
        - "https://bao.example.com/ui/vault/auth/oidc/oidc/callback"
    - client_id: "gitea"
      redirect_uris:
        - "https://git.example.com/user/oauth2/keycloak/callback"
      web_origins:
        - "https://git.example.com"
    - client_id: "example-automation"
      name: "Example automation"
      standard_flow_enabled: false
      service_accounts_enabled: true
      openbao:
        mount: "secret"
        path: "keycloak/clients/example-automation"
  realm_management:
    enabled: true
    client_id: "crossplane-keycloak"
    realm_roles:
      - "admin"
    openbao:
      mount: "secret"
      path: "crossplane/keycloak"
    rotation:
      period_seconds: 604800
      overlap_seconds: 172800
      renew_before_seconds: 3600

harbor_config:
  enabled: true
  validate_certs: true
  validate_registry_mirrors: true
  oidc:
    enabled: true
    endpoint: "https://keycloak.example.com/realms/homelab"
    scope: "openid,profile,email,offline_access"
    user_claim: "preferred_username"
    groups_claim: "groups"
    admin_group: "harbor-admins"
    verify_cert: true
  registry_mirrors:
    - name: "dockerhub"
      project_name: "dockerhub"
      type: "docker-hub"
      url: "https://hub.docker.com"
      public: true
      validation:
        enabled: true
        image: "library/busybox@sha256:1cfa4e2b09e127b9c4ed43578d3f3c18e7d44ea47b9ea98475c0cbe9086525f8"
    - name: "quay"
      project_name: "quay"
      type: "quay"
      url: "https://quay.io"
      public: true
      validation:
        enabled: true
        image: "prometheus/busybox:latest"
    - name: "ghcr"
      project_name: "ghcr"
      type: "github-ghcr"
      url: "https://ghcr.io"
      public: true
      validation:
        enabled: true
        image: "fluxcd/flux-cli:v2.4.0"

openbao_config:
  enabled: true
  secret_engines:
    - path: "secret"
      type: "kv-v2"
  oidc:
    enabled: true
    discovery_url: "https://keycloak.example.com/realms/homelab"
    default_role: "default"
    role:
      name: "default"
      user_claim: "sub"
      groups_claim: "groups"
      allowed_redirect_uris:
        - "https://bao.example.com/ui/vault/auth/oidc/oidc/callback"
      bound_audiences:
        - "openbao"

gitea_config:
  enabled: true
  validate_certs: true
  oidc:
    enabled: true
    name: "keycloak"
    discovery_url: "https://keycloak.example.com/realms/homelab/.well-known/openid-configuration"
    scopes: "openid email profile"
  validation:
    repo: "admin-node-validation"
    issue_title: "Backup restore sentinel"

observability:
  enabled: false
  metrics_endpoint: "http://victoriametrics.example.net:8428/opentelemetry/v1/metrics"
  logs_endpoint: "http://victorialogs.example.net:9428/insert/opentelemetry/v1/logs"
  collection_interval: "30s"
  expose_host_ports: false

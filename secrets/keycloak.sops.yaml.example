keycloak:
  db_password: "replace-me"
  admin_user: "admin"
  admin_password: "replace-me"
  ci_client_id: ""
  ci_client_secret: ""

keycloak_config:
  enabled: true
  realm:
    name: "homelab"
    display_name: "Homelab"
  realm_roles:
    - "admin"
    - "developer"
  clients:
    - client_id: "openbao"
      name: "OpenBao"
      public: false
      secret: "replace-me"
      redirect_uris:
        - "https://bao.example.com/ui/vault/auth/oidc/oidc/callback"
    - client_id: "harbor"
      name: "Harbor"
      public: false
      secret: "replace-me"
      redirect_uris:
        - "https://harbor.example.com/c/oidc/callback"
    # A client without an explicit secret lets Keycloak generate it. The
    # keycloak_config role can then publish it to the configured OpenBao KV-v2 path.
    - client_id: "example-automation"
      name: "Example automation"
      public: false
      standard_flow_enabled: false
      service_accounts_enabled: true
      openbao:
        mount: "secret"
        path: "keycloak/clients/example-automation"
  realm_management:
    enabled: true
    client_id: "crossplane-keycloak"
    realm_roles:
      - "admin"
    openbao:
      mount: "secret"
      path: "crossplane/keycloak"
    rotation:
      period_seconds: 604800
      overlap_seconds: 172800
      renew_before_seconds: 3600
  users:
    - username: "admin-user"
      first_name: "Admin"
      last_name: "User"
      email: "admin@example.com"
      password: "replace-me"
      realm_roles:
        - "admin"

{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboard": true,
  "timezone": "Europe/Paris",
  "labels": ["dependencies", "renovate", "admin-critical", "requires-lifecycle-ci"],
  "semanticCommits": "enabled",
  "semanticCommitType": "fix",
  "enabledManagers": [
    "docker-compose",
    "dockerfile",
    "github-actions",
    "gomod",
    "npm",
    "custom.regex"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the Gitea backup-restore-process GHCR image tag in scripts, templates, and docs.",
      "managerFilePatterns": [
        "/(^|/)scripts/gitea-process-backup\\.sh$/",
        "/(^|/)ansible/roles/backup/templates/gitea-process-backup-env\\.j2$/",
        "/(^|/)docs/(backup|restore-runbook)\\.md$/",
        "/(^|/)site/content/en/docs/(configuration/backup-hardening-observability|operations/backup-restore)\\.md$/"
      ],
      "matchStrings": [
        "(?<depName>ghcr\\.io/frantche/gitea-backup-restore-process):(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "ignorePaths": [
    "**/*.sops.yaml",
    "**/*.sops.yaml.example",
    "**/backups/**",
    "**/*.dump",
    "**/*.sql",
    "**/*.env",
    "**/credentials*.json",
    "**/secrets/**"
  ],
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["ci/oidc-user-journey/package.json"],
      "groupName": "playwright test dependencies"
    },
    {
      "matchManagers": ["gomod"],
      "matchFileNames": ["site/go.mod"],
      "groupName": "hugo modules"
    },
    {
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "Regrouper les mises a jour Docker majeures une fois par semaine",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["major"],
      "schedule": ["before 6am on monday"],
      "groupName": "docker major updates",
      "groupSlug": "docker-major",
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "Regrouper et fusionner les mises a jour Docker mineures une fois par semaine",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["minor"],
      "schedule": ["before 6am on monday"],
      "groupName": "docker minor updates",
      "groupSlug": "docker-minor",
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "platformAutomerge": true
    },
    {
      "description": "Regrouper et fusionner les correctifs et digests Docker une fois par semaine",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["patch", "pin", "pinDigest", "digest"],
      "schedule": ["before 6am on monday"],
      "groupName": "docker patch updates",
      "groupSlug": "docker-patch",
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "platformAutomerge": true
    }
  ]
}

{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboard": true,
  "timezone": "Europe/Paris",
  "labels": ["dependencies", "renovate", "admin-critical", "requires-lifecycle-ci"],
  "semanticCommits": "enabled",
  "semanticCommitType": "fix",
  "enabledManagers": [
    "docker-compose",
    "dockerfile",
    "github-actions",
    "gomod",
    "npm",
    "custom.regex"
  ],
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the Gitea backup-restore-process GHCR image tag in scripts, templates, and docs.",
      "managerFilePatterns": [
        "/(^|/)scripts/gitea-process-backup\\.sh$/",
        "/(^|/)ansible/roles/backup/templates/gitea-process-backup-env\\.j2$/",
        "/(^|/)docs/(backup|restore-runbook)\\.md$/",
        "/(^|/)site/content/en/docs/(configuration/backup-hardening-observability|operations/backup-restore)\\.md$/"
      ],
      "matchStrings": [
        "(?<depName>ghcr\\.io/frantche/gitea-backup-restore-process):(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "ignorePaths": [
    "**/*.sops.yaml",
    "**/*.sops.yaml.example",
    "**/backups/**",
    "**/*.dump",
    "**/*.sql",
    "**/*.env",
    "**/credentials*.json",
    "**/secrets/**"
  ],
  "packageRules": [
    {
      "description": "Regrouper toutes les mises a jour majeures pour validation manuelle hebdomadaire",
      "matchUpdateTypes": ["major"],
      "groupName": "weekly major dependency updates",
      "groupSlug": "weekly-major-dependencies",
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "Regrouper et fusionner les mises a jour non majeures une fois par semaine",
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest"],
      "groupName": "weekly non-major dependency updates",
      "groupSlug": "weekly-non-major-dependencies",
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "platformAutomerge": true
    }
  ]
}

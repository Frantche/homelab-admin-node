services:
  openbao:
    image: openbao/openbao:2.6.2@sha256:e29524ba7c3f20d01f562c481e3eccbad6c91df45a2f2531433da4951e408cff
    container_name: openbao
    restart: "no"
    read_only: true
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
{% if (hardening.apparmor.enabled | default(true) | bool) and (admin_apparmor_runtime_active | default(false) | bool) and ((hardening.apparmor.profiles | default({})).openbao | default(true) | bool) %}
      - "apparmor=admin-node-openbao"
{% endif %}
    pids_limit: 256
    mem_limit: 512m
    cpus: 2.0
    tmpfs:
      # Snapshot and backup commands run as the image's openbao user.
      - /tmp:size=32m,mode=0700,uid=100,gid=1000
    command: server -config=/etc/openbao/openbao.hcl
    volumes:
      - ./openbao.hcl:/etc/openbao/openbao.hcl:ro
      - /srv/admin/data/openbao:/openbao/file
      - "{{ admin_node_root }}/backups/openbao-scratch:/openbao/snapshot"
      - /srv/admin/certs/openbao-internal-ca.pem:/openbao/tls/ca.pem:ro
      - /srv/admin/certs/openbao-internal-cert.pem:/openbao/tls/tls.crt:ro
      - /srv/admin/certs/openbao-internal-key.pem:/openbao/tls/tls.key:ro
    healthcheck:
      test: ["CMD-SHELL", "BAO_ADDR=https://127.0.0.1:8200 BAO_CACERT=/openbao/tls/ca.pem bao status -format=json >/dev/null; rc=$$?; [ $$rc -eq 0 ] || [ $$rc -eq 2 ]"]
      interval: 5s
      timeout: 3s
      retries: 30
      start_period: 10s
    networks:
      - traefik-openbao
      - openbao-metrics

networks:
  traefik-openbao:
    external: true
  openbao-metrics:
    external: true

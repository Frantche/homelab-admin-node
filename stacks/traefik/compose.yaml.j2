services:
  traefik:
    image: traefik:v3.7@sha256:7523e37d0694ff940ee9cefe2184c5869dd0c0db7d6c5ee78254f7d985deecc6
    container_name: traefik
    init: true
    restart: "no"
    read_only: true
    cap_drop:
      - ALL
    cap_add:
      - NET_BIND_SERVICE
    pids_limit: 256
    mem_limit: 256m
    cpus: 1.0
    tmpfs:
      - /tmp:size=32m,mode=0700
    command:
      - --configFile=/etc/traefik/traefik.yml
    security_opt:
      - no-new-privileges:true
{% if (hardening.apparmor.enabled | default(true) | bool) and (admin_apparmor_runtime_active | default(false) | bool) and ((hardening.apparmor.profiles | default({})).traefik | default(true) | bool) %}
      - "apparmor=admin-node-traefik"
{% endif %}
    ports:
      - "443:443"
    volumes:
      - ./traefik.yml:/etc/traefik/traefik.yml:ro
      - ./dynamic:/etc/traefik/dynamic:ro
      - /srv/admin/data/traefik/letsencrypt:/letsencrypt
      - /srv/admin/certs:/certs:ro
    env_file: "{{ admin_node_root }}/env/traefik.env"
    healthcheck:
      test: ["CMD", "traefik", "healthcheck", "--ping"]
      interval: 5s
      timeout: 3s
      retries: 30
      start_period: 10s
    networks:
      admin-edge:
        aliases:
          - "{{ service_domains.keycloak }}"
          - "{{ service_domains.harbor }}"
          - "{{ service_domains.gitea | default('git.example.com') }}"
          - "{{ service_domains.traefik }}"
      traefik-openbao:
        aliases:
          # OpenBao reaches Keycloak through Traefik without joining admin-edge.
          - "{{ service_domains.keycloak }}"

networks:
  admin-edge:
    external: true
  traefik-openbao:
    external: true

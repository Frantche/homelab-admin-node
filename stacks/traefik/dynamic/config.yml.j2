http:
  routers:
    openbao:
      rule: "Host(`{{ service_domains.openbao }}`)"
      entryPoints:
        - websecure
        - cloudflarewebsecure
{% if traefik_letsencrypt_enabled | default(false) %}
      tls:
        certResolver: letsencrypt
{% else %}
      tls: true
{% endif %}
      service: openbao
      middlewares:
        - interactive-protection
    keycloak:
      rule: "Host(`{{ service_domains.keycloak }}`)"
      entryPoints:
        - websecure
        - cloudflarewebsecure
{% if traefik_letsencrypt_enabled | default(false) %}
      tls:
        certResolver: letsencrypt
{% else %}
      tls: true
{% endif %}
      service: keycloak
      middlewares:
        - interactive-protection
    gitea:
      rule: "Host(`{{ service_domains.gitea | default('git.example.com') }}`)"
      entryPoints:
        - websecure
        - cloudflarewebsecure
{% if traefik_letsencrypt_enabled | default(false) %}
      tls:
        certResolver: letsencrypt
{% else %}
      tls: true
{% endif %}
      service: gitea
      # Git LFS uploads are intentionally not subject to request rate or body
      # limits. Concurrency still protects the backend from exhaustion.
      middlewares:
        - transfer-protection
    harbor:
      rule: "Host(`{{ service_domains.harbor }}`)"
      entryPoints:
        - websecure
        - cloudflarewebsecure
{% if traefik_letsencrypt_enabled | default(false) %}
      tls:
        certResolver: letsencrypt
{% else %}
      tls: true
{% endif %}
      service: harbor
      # Registry pushes can be large and long-lived: do not add buffering or a
      # request rate limit to this router.
      middlewares:
        - transfer-protection
{% if crowdsec.enabled | default(false) | bool %}
    crowdsec-lapi:
      rule: "Host(`{{ service_domains.crowdsec }}`)"
      entryPoints:
        - websecure
{% if traefik_letsencrypt_enabled | default(false) %}
      tls:
        certResolver: letsencrypt
{% else %}
      tls: true
{% endif %}
      service: crowdsec-lapi
      # The entrypoint middleware protects this route too. The plugin reaches
      # crowdsec:8080 directly over the private network, so it cannot recurse.
      middlewares:
        - security-headers
        - crowdsec-lapi-allowlist
{% endif %}
{% if traefik.dashboard_enabled | default(false) | bool %}
    dashboard:
      rule: "Host(`{{ service_domains.traefik }}`)"
      entryPoints:
        - websecure
{% if traefik_letsencrypt_enabled | default(false) %}
      tls:
        certResolver: letsencrypt
{% else %}
      tls: true
{% endif %}
      service: api@internal
      middlewares:
        - dashboard-auth
        - interactive-protection
{% endif %}
{% for external_service in traefik_external_services | default([]) %}
    {{ external_service.name }}:
      rule: "Host(`{{ external_service.hostname }}`)"
      entryPoints:
        - websecure
{% if external_service.cloudflare | default(false) | bool %}
        - cloudflarewebsecure
{% endif %}
{% if traefik_letsencrypt_enabled | default(false) %}
      tls:
        certResolver: letsencrypt
{% else %}
      tls: true
{% endif %}
      service: {{ external_service.name }}
      middlewares:
{% if crowdsec.enabled | default(false) | bool %}
        - external-protection
{% else %}
        - security-headers
{% endif %}
{% endfor %}
  services:
    openbao:
      loadBalancer:
        serversTransport: openbao-internal
        servers:
          - url: "https://openbao:8200"
    keycloak:
      loadBalancer:
        servers:
          - url: "http://keycloak:8080"
    gitea:
      loadBalancer:
        servers:
          - url: "http://gitea:3000"
    harbor:
      loadBalancer:
        servers:
          - url: "http://harbor-nginx:8080"
{% if crowdsec.enabled | default(false) | bool %}
    crowdsec-lapi:
      loadBalancer:
        servers:
          - url: "http://crowdsec:8080"
{% endif %}
{% for external_service in traefik_external_services | default([]) %}
    {{ external_service.name }}:
      loadBalancer:
{% if ((external_service.tls | default({})).verify | default(true) | bool == false) or (((external_service.tls | default({})).ca_pem | default('', true) | length) > 0) %}
        serversTransport: {{ external_service.name }}
{% endif %}
        servers:
          - url: "{{ external_service.url }}"
{% endfor %}
{% set external_services_with_transport = [] %}
{% for external_service in traefik_external_services | default([]) %}
{% if ((external_service.tls | default({})).verify | default(true) | bool == false) or (((external_service.tls | default({})).ca_pem | default('', true) | length) > 0) %}
{% set _ = external_services_with_transport.append(external_service) %}
{% endif %}
{% endfor %}
  serversTransports:
    openbao-internal:
      serverName: openbao
      rootCAs:
        - /certs/openbao-internal-ca.pem
{% if external_services_with_transport | length > 0 %}
{% for external_service in external_services_with_transport %}
    {{ external_service.name }}:
{% if (external_service.tls | default({})).verify | default(true) | bool == false %}
      insecureSkipVerify: true
{% else %}
      rootCAs:
        - /certs/traefik-external-services/{{ external_service.name }}-ca.pem
{% endif %}
{% endfor %}
{% endif %}
  middlewares:
    security-headers:
      headers:
        browserXssFilter: true
        contentTypeNosniff: true
        customFrameOptionsValue: "SAMEORIGIN"
        forceSTSHeader: true
        frameDeny: false
        hostsProxyHeaders:
          - X-Forwarded-Host
        permissionsPolicy: "camera=(), geolocation=(), microphone=()"
        referrerPolicy: "strict-origin-when-cross-origin"
        stsIncludeSubdomains: true
        stsPreload: true
        stsSeconds: 31536000
    interactive-rate-limit:
      rateLimit:
        average: {{ traefik.security.interactive_rate_limit.average | default(100) }}
        burst: {{ traefik.security.interactive_rate_limit.burst | default(200) }}
        period: "1s"
    interactive-concurrency:
      inFlightReq:
        amount: {{ traefik.security.interactive_max_in_flight | default(100) }}
    transfer-concurrency:
      inFlightReq:
        amount: {{ traefik.security.transfer_max_in_flight | default(200) }}
    interactive-protection:
      chain:
        middlewares:
          - security-headers
          - interactive-rate-limit
          - interactive-concurrency
    transfer-protection:
      chain:
        middlewares:
          - security-headers
          - transfer-concurrency
    external-protection:
      chain:
        middlewares:
          - security-headers
{% if crowdsec.enabled | default(false) | bool %}
    crowdsec-bouncer:
      plugin:
        crowdsec-bouncer:
          enabled: true
          crowdsecMode: stream
          crowdsecLapiScheme: http
          crowdsecLapiHost: crowdsec:8080
          crowdsecLapiKeyFile: /run/secrets/crowdsec-traefik-bouncer-key
          updateIntervalSeconds: {{ crowdsec.traefik_bouncer.update_interval_seconds | default(60) }}
          updateMaxFailure: -1
          crowdsecAppsecEnabled: false
{% if (traefik.forwarded_headers_trusted_ips | default([])) | length > 0 %}
          forwardedHeadersTrustedIPs:
{% for cidr in traefik.forwarded_headers_trusted_ips %}
            - "{{ cidr }}"
{% endfor %}
            - "{{ ((cloudflare.origin_network | default({})).cloudflared_ip | default('172.31.255.3')) }}/32"
{% else %}
          forwardedHeadersTrustedIPs:
            - "{{ ((cloudflare.origin_network | default({})).cloudflared_ip | default('172.31.255.3')) }}/32"
{% endif %}
    crowdsec-lapi-allowlist:
      ipAllowList:
        sourceRange:
{% for cidr in crowdsec.lapi.allowed_cidrs | default([]) %}
          - "{{ cidr }}"
{% endfor %}
{% endif %}
{% if traefik.dashboard_enabled | default(false) | bool %}
    dashboard-auth:
      basicAuth:
        users:
          - "{{ TRAEFIK_DASHBOARD_BASIC_AUTH }}"
{% endif %}

services:
  cloudflared:
    image: cloudflare/cloudflared:2026.8.2@sha256:de55830499e9adb1c580f7b5cbbdef86a3ff1715fb3ae6b3ff242f19de0afde8
    container_name: cloudflared
    restart: "no"
    user: "65532:65532"
    read_only: true
    cap_drop:
      - ALL
    pids_limit: 256
    mem_limit: 256m
    cpus: 1.0
    tmpfs:
      - /tmp:size=32m,mode=0700
    command: tunnel --metrics 0.0.0.0:20241 --config /etc/cloudflared/config.yml run {{ cloudflare.tunnel_id }}
    volumes:
      - ./config.yml:/etc/cloudflared/config.yml:ro
      - ./credentials.json:/etc/cloudflared/credentials.json:ro
{% if not (traefik_letsencrypt_enabled | default(false) | bool) %}
      - /srv/admin/certs/ca.pem:/etc/cloudflared/admin-node-ca.pem:ro
{% endif %}
    security_opt:
      - no-new-privileges:true
{% if (hardening.apparmor.enabled | default(true) | bool) and (admin_apparmor_runtime_active | default(false) | bool) and ((hardening.apparmor.profiles | default({})).cloudflared | default(true) | bool) %}
      - "apparmor=admin-node-cloudflared"
{% endif %}
    healthcheck:
      test: ["CMD", "cloudflared", "tunnel", "--metrics", "127.0.0.1:20241", "ready"]
      interval: 10s
      timeout: 5s
      retries: 30
      start_period: 20s
    networks:
      - admin-edge

networks:
  admin-edge:
    external: true

services:
  gitea-db:
    image: pgautoupgrade/pgautoupgrade:18-trixie@sha256:65a2b843dcfec2679a92ece765d7bc243eee9b743ecafcf8a0d181f243c14479
    container_name: gitea-db
    restart: "no"
    read_only: true
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - DAC_OVERRIDE
      - SETGID
      - SETUID
    security_opt:
      - no-new-privileges:true
    pids_limit: 256
    mem_limit: 1g
    cpus: 2.0
    tmpfs:
      - /tmp:size=64m,mode=1777
      - /var/run/postgresql:size=16m,mode=0775
    command:
      - postgres
      - -c
      - max_wal_size=1GB
      - -c
      - min_wal_size=128MB
      - -c
      - wal_keep_size=128MB
    environment:
      POSTGRES_DB: gitea
      POSTGRES_USER: gitea
      POSTGRES_PASSWORD: ${GITEA_DB_PASSWORD}
    volumes:
      - /srv/admin/data/gitea-stack/postgres:/var/lib/postgresql
    healthcheck:
      test: ["CMD", "pg_isready", "-U", "gitea"]
      interval: 5s
      timeout: 3s
      retries: 30
    networks:
      - gitea-db

  gitea:
    image: docker.gitea.com/gitea:1.27.1@sha256:b64126cf5c3f4e5f0f231b510bb13715f6cb8e508188b44de90bdb9a04f3055d
    container_name: gitea
    restart: "no"
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - DAC_OVERRIDE
      - SETGID
      - SETUID
    security_opt:
      - no-new-privileges:true
    pids_limit: 512
    mem_limit: 1g
    cpus: 2.0
    environment:
      USER_UID: "1000"
      USER_GID: "1000"
      GITEA__database__DB_TYPE: postgres
      GITEA__database__HOST: gitea-db:5432
      GITEA__database__NAME: gitea
      GITEA__database__USER: gitea
      GITEA__database__PASSWD: ${GITEA_DB_PASSWORD}
      GITEA__server__DOMAIN: "{{ service_domains.gitea | default('git.example.com') }}"
      GITEA__server__ROOT_URL: "https://{{ service_domains.gitea | default('git.example.com') }}/"
      GITEA__server__HTTP_PORT: "3000"
      GITEA__server__DISABLE_SSH: "true"
      GITEA__server__LFS_START_SERVER: "true"
      GITEA__security__INSTALL_LOCK: "true"
      GITEA__security__SECRET_KEY: ${GITEA_SECRET_KEY}
      GITEA__security__INTERNAL_TOKEN: ${GITEA_INTERNAL_TOKEN}
      GITEA__oauth2__JWT_SECRET: ${GITEA_JWT_SECRET}
      GITEA__oauth2_client__ENABLE_AUTO_REGISTRATION: "true"
      GITEA__oauth2_client__USERNAME: "preferred_username"
      GITEA__service__DISABLE_REGISTRATION: "false"
      GITEA__service__ALLOW_ONLY_EXTERNAL_REGISTRATION: "true"
      GITEA__service__SHOW_REGISTRATION_BUTTON: "false"
      GITEA__openid__ENABLE_OPENID_SIGNIN: "false"
      GITEA__openid__ENABLE_OPENID_SIGNUP: "true"
      GITEA__openid__WHITELISTED_URIS: "{{ service_domains.keycloak }}"
      GITEA__metrics__ENABLED: "true"
{% if traefik_local_ca_enabled | default(ci_mode | default(false)) | bool %}
      SSL_CERT_FILE: /etc/ssl/certs/admin-node-ca.pem
{% endif %}
    volumes:
      - /srv/admin/data/gitea-stack/gitea:/data
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
{% if traefik_local_ca_enabled | default(ci_mode | default(false)) | bool %}
      - /srv/admin/certs/ca.pem:/etc/ssl/certs/admin-node-ca.pem:ro
{% endif %}
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://127.0.0.1:3000/api/healthz"]
      interval: 10s
      timeout: 5s
      retries: 30
      start_period: 20s
    depends_on:
      gitea-db:
        condition: service_healthy
    networks:
      - admin-edge
      - gitea-db

networks:
  admin-edge:
    external: true
  gitea-db:
    external: true

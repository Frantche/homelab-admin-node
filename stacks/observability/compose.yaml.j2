services:
{% if observability.mock_backend_enabled | default(false) | bool %}
  otel-mock-backend:
    image: python:3.14-alpine@sha256:0ad7f98a97b1b8fcc226f5cbe49f0b95cd6f624582cdc6fbf7e41312075cb401
    container_name: otel-mock-backend
    restart: "no"
    read_only: true
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    pids_limit: 128
    mem_limit: 128m
    cpus: 1.0
    tmpfs:
      - /tmp:size=16m,mode=1777
    command:
      - python
      - /otel-mock-backend.py
      - --host
      - 0.0.0.0
      - --port
      - "43190"
      - --state-dir
      - /state
    healthcheck:
      test:
        - CMD
        - python
        - -c
        - "import urllib.request; urllib.request.urlopen('http://127.0.0.1:43190/healthz', timeout=2).read()"
      interval: 2s
      timeout: 3s
      retries: 15
    volumes:
      - {{ admin_repo_root | default('/opt/homelab-admin-node') }}/ci/otel-mock-backend.py:/otel-mock-backend.py:ro
      - {{ observability.mock_state_dir | default('/tmp/admin-node-otel-mock') }}:/state
    networks:
      - admin-edge
      - harbor-internal
      - openbao-metrics

{% endif %}
  otel-collector:
    image: otel/opentelemetry-collector-contrib:0.159.0@sha256:4f4276c07cee9055f2ab630a86330243f85e208c388ee697bea2a44dab896c3f
    container_name: otel-collector
    restart: "no"
    user: "10001:10001"
    read_only: true
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    tmpfs:
      - /tmp:size=32m,mode=0700
    pids_limit: 256
    mem_limit: 512m
    cpus: 2.0
    command:
      - --config=/etc/otelcol/config.yaml
    healthcheck:
      test: ["CMD", "/otelcol-contrib", "validate", "--config=/etc/otelcol/config.yaml"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 10s
    volumes:
      - ./otel-collector.yaml:/etc/otelcol/config.yaml:ro
      - /srv/admin/certs/openbao-internal-ca.pem:/etc/otelcol/openbao-ca.pem:ro
      - /proc:/hostfs/proc:ro
      - /sys:/hostfs/sys:ro
      - /var/log/admin-node-security-exceptions.log:/var/log/admin-node-security-exceptions.log:ro
{% if observability.mock_backend_enabled | default(false) | bool %}
    depends_on:
      otel-mock-backend:
        condition: service_healthy
    network_mode: "service:otel-mock-backend"
{% else %}
{% if observability.expose_host_ports | default(false) | bool %}
    ports:
      - "127.0.0.1:4317:4317"
      - "127.0.0.1:4318:4318"
{% endif %}
    networks:
      - admin-edge
      - harbor-internal
      - openbao-metrics
{% endif %}

networks:
  admin-edge:
    external: true
  harbor-internal:
    external: true
  openbao-metrics:
    external: true

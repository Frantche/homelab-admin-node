profile: production
skip_list:
  # Existing debt: keep new checks deterministic without forcing a broad
  # role-variable and command idempotence refactor into this maintenance PR.
  - fqcn[canonical]
  - name[casing]
  - name[play]
  - no-changed-when
  - risky-shell-pipe
  - var-naming
  - command-instead-of-shell
  - jinja
  - yaml[line-length]
